<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PostLock:Boot: standalone boot-trigger for the CVE-2026-43499
         restore chain on the relocked OPPO A96.  Deliberately independent
         of the BakaSU manager app (no shared code, no shared signing). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- keeps the screen on during a chain run: OPPO HANS freezes the uid
         on LcdOff (destroying our sockets), wake lock is the defence -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="PostLock:Boot"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- manual test: am broadcast -a com.postlock.boot.LAUNCH -->
                <action android:name="com.postlock.boot.LAUNCH" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
